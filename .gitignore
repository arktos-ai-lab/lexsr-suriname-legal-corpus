# Virtual environments
venv/
ENV/
env/

# Secrets
.env
.env.*

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Data directories (generated during ingestion)
data/
data_*/

# Generated static site output
site/

# Ad hoc test/scratch scripts at the repo root only — NOT tests/, which is
# the real pytest suite (a bare "test_*.py" here would silently un-track
# every new file added to tests/, since gitignore patterns without a
# leading "/" match at any depth).
/test_*.py
/*_test.py

# Databases (generated)
*.db
*.db-journal
*.db-wal
*.db-shm

# Logs
*.log

# Temporary files
*.tmp
*.temp
.DS_Store

# Model files (large)
*.bin
*.pth
*.onnx

# LaTeX build artifacts (keep the .tex source and compiled .pdf)
*.aux
*.out
*.fls
*.fdb_latexmk
*.synctex.gz
*.bbl
*.blg
*.toc

# Paper sources and PDF (kept locally; the paper is cited in README.md)
article/
